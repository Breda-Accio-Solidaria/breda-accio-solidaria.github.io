---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import Badge from '../../components/Badge.astro';
import RelatedEventCard from '../../components/RelatedEventCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { humanize, formatDate } from '../../utils/format';

export async function getStaticPaths() {
  const items = await getCollection(
    'campanyes',
    ({ data }) => !data.draft
  );

  return items.map((item) => ({
    params: { id: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);

const dateRange = [
  item.data.startDate && formatDate(item.data.startDate),
  item.data.endDate && formatDate(item.data.endDate),
]
  .filter(Boolean)
  .join(' — ');

const relatedEvents = (
  await getCollection(
    'agenda',
    ({ data }) =>
      !data.draft &&
      data.status === 'confirmada' &&
      data.campaign === item.id
  )
).sort(
  (a, b) =>
    a.data.startDate.valueOf() -
    b.data.startDate.valueOf()
);
---

<ArticleLayout
  title={item.data.title}
  summary={item.data.summary}
  eyebrow="Campanya"
  meta={dateRange || undefined}
  isPlaceholder={item.data.isPlaceholder}
  topics={item.data.topics}
  image={item.data.image}
  imageAlt={item.data.imageAlt}
>
  <p>
    <Badge
      tone={
        item.data.status === 'activa'
          ? 'red'
          : item.data.status === 'permanent'
            ? 'green'
            : 'neutral'
      }
    >
      {humanize(item.data.status)}
    </Badge>
  </p>

  <Content />

  {
    relatedEvents.length > 0 && (
      <section class="related-events">
        <SectionHeading
          eyebrow="Agenda"
          title="Activitats vinculades"
          intro="Xerrades, debats i altres activitats confirmades dins d’aquesta línia d’acció."
        />

        <div class="related-events-grid">
          {
            relatedEvents.map((event) => (
              <RelatedEventCard item={event} />
            ))
          }
        </div>
      </section>
    )
  }

  {
    item.data.callToAction && (
      <aside class="cta">
        <h2>Com participar-hi</h2>
        <p>{item.data.callToAction}</p>
        <p>
          <a href="/contacte/">Contacta amb el BAS</a>
        </p>
      </aside>
    )
  }

  {
    item.data.relatedLinks.length > 0 && (
      <section>
        <h2>Recursos relacionats</h2>

        <ul>
          {
            item.data.relatedLinks.map((link) => (
              <li>
                <a href={link.url} rel="external">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    )
  }
</ArticleLayout>

<style>
  .related-events {
    margin-top: clamp(3rem, 7vw, 5rem);
    padding-top: clamp(2rem, 5vw, 3.5rem);
    border-top: 1px solid var(--color-border);
  }

  .cta {
    margin-top: 2.5rem;
    padding: 1.4rem;
    background: var(--color-mint);
    border-left: 7px solid var(--color-green);
  }

  .related-events-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  @media (max-width: 48rem) {
    .related-events-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
