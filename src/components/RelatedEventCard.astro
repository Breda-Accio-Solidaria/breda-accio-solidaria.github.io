---
import type { CollectionEntry } from 'astro:content';
import Badge from './Badge.astro';
import { agendaFormatMeta } from '../data/agenda';
import { formatDateTime } from '../utils/format';

interface Props {
  item: CollectionEntry<'agenda'>;
}

const { item } = Astro.props;
const formatMeta = agendaFormatMeta[item.data.format];

const day = new Intl.DateTimeFormat('ca-ES', {
  day: 'numeric',
}).format(item.data.startDate);

const month = new Intl.DateTimeFormat('ca-ES', {
  month: 'short',
})
  .format(item.data.startDate)
  .replace('.', '')
  .toLowerCase();
---

<article class="related-event-card">
  <div class="date" aria-hidden="true">
    <strong>{day}</strong>
    <span>{month}</span>
  </div>

  <div class="content">
    <Badge tone={formatMeta.tone}>
      {formatMeta.label}
    </Badge>

    <h3>
      <a href={`/agenda/${item.id}/`}>
        {item.data.title}
      </a>
    </h3>

    <dl>
      <div>
        <dt class="sr-only">Data i hora</dt>
        <dd>{formatDateTime(item.data.startDate)}</dd>
      </div>

      <div>
        <dt class="sr-only">Lloc</dt>
        <dd>{item.data.location}</dd>
      </div>
    </dl>
  </div>
</article>

<style>
  .related-event-card {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
    height: 100%;
    padding: 1.1rem;
    background: var(--color-vanilla);
    border: 1px solid var(--color-border);
    border-top: 4px solid var(--color-red);
  }

  .related-event-card:hover {
    border-color: var(--color-border-strong);
  }

  .date {
    display: grid;
    place-items: center;
    min-width: 3.8rem;
    padding: 0.65rem 0.5rem;
    background: var(--color-ink);
    color: var(--color-vanilla);
    line-height: 1;
  }

  .date strong {
    font-family: var(--font-serif);
    font-size: 1.8rem;
  }

  .date span {
    margin-top: 0.3rem;
    font-size: 0.78rem;
    font-weight: 800;
  }

  .content {
    min-width: 0;
  }

  h3 {
    margin: 0.65rem 0 0;
    font-size: 1.25rem;
    line-height: 1.15;
  }

  h3 a {
    color: var(--color-ink);
    text-decoration: none;
  }

  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  h3 a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2rem;
  }

  dl {
    display: grid;
    gap: 0.15rem;
    margin: 0.75rem 0 0;
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  dd {
    margin: 0;
  }

  @media (max-width: 32rem) {
    .related-event-card {
      grid-template-columns: 1fr;
    }

    .date {
      display: flex;
      justify-content: flex-start;
      gap: 0.35rem;
      min-width: 0;
      width: max-content;
    }

    .date strong {
      font-size: 1.2rem;
    }

    .date span {
      margin-top: 0;
    }
  }
</style>